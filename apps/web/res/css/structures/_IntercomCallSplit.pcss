/* The call of a room over its timeline, with a bar between them that is dragged */
.mx_IntercomCallSplit {
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    min-height: 0;
    /* Over the timeline's own floating parts (jump to bottom, unread bar) */
    position: relative;
    z-index: 1;
}

.mx_IntercomCallSplit_call {
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    min-height: 0;
    overflow: hidden;
    background-color: $call-background;

    .mx_CallView {
        /* The room's header has its own line under it */
        background-color: transparent;
    }
}

/* The call alone: all of the room, and no bar */
.mx_IntercomCallSplit[data-full="true"] {
    flex: 1 1 auto;

    .mx_IntercomCallSplit_call {
        flex: 1 1 auto;
    }

    .mx_IntercomCallSplit_bar {
        display: none;
    }
}

.mx_IntercomCallSplit[data-dragging="false"][data-full="false"] .mx_IntercomCallSplit_call {
    transition: height 160ms cubic-bezier(0.2, 0, 0, 1);
}

@media (prefers-reduced-motion: reduce) {
    .mx_IntercomCallSplit[data-dragging="false"][data-full="false"] .mx_IntercomCallSplit_call {
        transition: none;
    }
}

.mx_IntercomCallSplit_bar {
    position: relative;
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    height: 20px;
    border-bottom: 1px solid var(--cpd-color-border-disabled);
    background-color: var(--cpd-color-bg-canvas-default);
}

.mx_IntercomCallSplit_handle {
    flex: 1;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: row-resize;
    touch-action: none;
    outline: none;

    &:hover .mx_IntercomCallSplit_grip,
    &:focus-visible .mx_IntercomCallSplit_grip,
    .mx_IntercomCallSplit[data-dragging="true"] & .mx_IntercomCallSplit_grip {
        background-color: var(--cpd-color-icon-accent-tertiary);
        width: 64px;
    }

    &:focus-visible {
        box-shadow: inset 0 0 0 2px var(--cpd-color-border-focused);
    }
}

.mx_IntercomCallSplit_grip {
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background-color: var(--cpd-color-icon-quaternary);
    transition:
        width 120ms ease-out,
        background-color 120ms ease-out;
}

.mx_IntercomCallSplit_buttons {
    position: absolute;
    inset-inline-end: var(--cpd-space-2x);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    gap: var(--cpd-space-1x);

    button {
        --cpd-icon-button-size: 20px;
    }
}

/* Under the call the timeline is what gives way */
.mx_MainSplit_callSplit {
    .mx_RoomView_timeline {
        min-height: 0;
    }
}
