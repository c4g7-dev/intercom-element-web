/* Several pictures sent together, as one grid of cropped previews */
.mx_IntercomGallery {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 4px;
    width: 100%;
    max-width: 520px;
    margin-bottom: var(--cpd-space-1x);
    border-radius: 8px;
    overflow: hidden;
}

/* Two pictures need less room than three in a row */
.mx_IntercomGallery[data-count="2"],
.mx_IntercomGallery[data-count="4"] {
    max-width: 440px;
}

.mx_IntercomGallery_cell {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-radius: 4px;
    background-color: var(--cpd-color-bg-subtle-secondary);
    grid-column: span 2;
    aspect-ratio: 1 / 1;

    &[hidden] {
        display: none;
    }

    &[data-span="3"] {
        grid-column: span 3;
        aspect-ratio: 4 / 3;
    }

    &[data-span="6"] {
        grid-column: span 6;
        aspect-ratio: 16 / 9;
    }

    /* The image body fills its cell, whatever size the picture asks for, and is cropped to it */
    .mx_ImageBody {
        position: absolute;
        inset: 0;
        display: block;
        margin: 0;

        > a {
            display: block;
            width: 100%;
            height: 100%;
            max-width: none;
        }
    }

    .mx_ImageBody_container {
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        max-height: none !important;
        min-width: 0;
        min-height: 0;
        aspect-ratio: auto !important;
        border-radius: 0;

        > div {
            width: 100% !important;
            height: 100% !important;
            max-width: none !important;
            max-height: none !important;
        }

        /* The "show image" button of hidden media */
        > div > div[style] {
            width: 100% !important;
            height: 100% !important;
        }

        /* The file name shown over a single picture is too much for a small cell */
        > div > span {
            display: none;
        }
    }

    .mx_ImageBody_image {
        object-fit: cover;
        transition: filter 120ms ease-out;
    }

    &:hover .mx_ImageBody_image {
        filter: brightness(1.08);
    }

    /* An image that failed: its message, in the middle of the cell */
    span.mx_ImageBody {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--cpd-space-1x);
        padding: var(--cpd-space-2x);
        font: var(--cpd-font-body-sm-regular);
        text-align: center;
    }
}

/* "+N" over the last cell that is shown: the cell under it still takes the click */
.mx_IntercomGallery_more {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgb(0 0 0 / 60%);
    color: #fff;
    font: var(--cpd-font-heading-lg-semibold);
    pointer-events: none;
}

/* The dialog that asks once for several pictures: the same grid, and a caption */
.mx_IntercomBatchUploadDialog {
    width: min(520px, 90vw);
}

.mx_IntercomBatchUploadDialog_preview {
    margin-inline: auto;
}

.mx_IntercomBatchUploadDialog_image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.mx_IntercomBatchUploadDialog_summary {
    margin: var(--cpd-space-3x) 0;
    color: $secondary-content;
    font: var(--cpd-font-body-sm-regular);
}

.mx_IntercomBatchUploadDialog_caption {
    box-sizing: border-box;
    width: 100%;
    margin: 0;
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: 8px;
    background-color: var(--cpd-color-bg-canvas-default);
    color: $primary-content;
    font: var(--cpd-font-body-md-regular);

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        outline-offset: 1px;
    }
}
