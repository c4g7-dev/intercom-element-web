/*
 * InterCom's flat layer. Imported last by the light, dark and custom theme entrypoints, so it
 * applies whichever theme is selected; the colours themselves come from the "InterCom Dark" and
 * "InterCom Light" custom themes in the bundled config.json.
 *
 * It only restyles surfaces: no drop shadows, one border, three radii. Nothing here changes layout
 * or component structure, so it can be deleted without consequence.
 *
 * `:root:root` raises specificity above the nested upstream rules it replaces (for instance
 * `.mx_BaseCard .mx_ContextualMenu`) without resorting to `!important`.
 */

:root {
    --ic-radius-sm: 6px;
    --ic-radius-md: 8px;
    --ic-radius-lg: 12px;
    --ic-surface-border: var(--cpd-border-width-1) solid var(--cpd-color-gray-400);
    /* The line between two surfaces, and the curve of everything that moves */
    --ic-separator-color: var(--roomlist-separator-color, var(--cpd-color-gray-400));
    --ic-hairline: var(--cpd-border-width-1) solid var(--ic-separator-color);
    --ic-ease: cubic-bezier(0.2, 0, 0, 1);

    /* Message bubbles, images and other message bodies */
    --MBody-border-radius: var(--ic-radius-md);
}

/* Floating surfaces: separated from the page by a border rather than by a shadow */
:root:root .mx_ContextualMenu,
:root:root .mx_InteractiveTooltip,
:root:root .mx_Autocomplete,
:root:root .mx_ToastContainer .mx_Toast_toast,
:root:root .mx_BeaconStatusTooltip,
:root:root .mx_DialogOwnBeaconStatus {
    box-shadow: none;
    border: var(--ic-surface-border);
    border-radius: var(--ic-radius-md);
}

:root:root .mx_Autocomplete {
    border-bottom: none;
    border-radius: var(--ic-radius-md) var(--ic-radius-md) 0 0;
}

:root:root .mx_ToastContainer.mx_ToastContainer_stacked::before {
    box-shadow: none;
    border-radius: var(--ic-radius-md);
}

/*
 * Compound's submenus ("Move to" in a room's menu, …): a menu without a title, whose content is
 * padded like a full menu's (20 px above, 16 px below), so that one row stood in a box twice its
 * height. Padded to their rows like a list instead. Compound's class names are hashed: the
 * submenu is the Radix menu content that Compound gives an empty label.
 */
:root:root [data-radix-menu-content][role="menu"][aria-label=""] > [role="none"] {
    --cpd-menu-padding-block-end: var(--cpd-space-1-5x);

    padding-block: var(--cpd-space-1-5x);
    min-block-size: 0;
}

/* Compound places a submenu 20 px up, for its first row to be level with the row that opened it */
:root:root [data-radix-menu-content][role="menu"][aria-label=""][data-align="start"] {
    margin-block-start: calc(var(--cpd-space-5x) - var(--cpd-space-1-5x));
}

/* In-page surfaces which carried a decorative shadow */
:root:root .mx_PinnedMessageBanner,
:root:root .mx_ReplyPreview,
:root:root .mx_CompoundDialog_footer,
:root:root .mx_AuthPage_modal.mx_AuthPage_modal_withBlur,
:root:root .mx_LegacyCallView.mx_LegacyCallView_pip {
    box-shadow: none;
}

:root:root .mx_EncryptionCard {
    box-shadow: none;
    border: var(--ic-surface-border);
    border-radius: var(--ic-radius-lg);
}

/* Sign-in card */
:root:root .mx_AuthPage_modal {
    border-radius: var(--ic-radius-lg);
    overflow: hidden;
}

/*
 * The side panel with the logo shows the card's own background. Upstream makes that a blurred copy
 * of the page background under a translucent wash, and the custom themes inherit the light wash
 * (white at 59 %) whether they are dark or not: a grey panel in InterCom Dark. A flat surface in
 * the theme's panel colour instead, no blur, and a hairline around the card.
 */
:root:root .mx_AuthPage_modal_withBlur {
    border: var(--cpd-border-width-1) solid var(--roomlist-separator-color, var(--cpd-color-gray-400));
}

:root:root .mx_AuthPage_modal_withBlur .mx_AuthPage_modalBlur {
    display: none;
}

:root:root .mx_AuthPage_modal_withBlur .mx_AuthPage_modalContent {
    background-color: var(--roomlist-background-color, var(--cpd-color-bg-subtle-secondary));
}

/* The card clips its corners, the form inside does not round its own */
:root:root .mx_AuthPage_modal_withBlur .mx_AuthBody {
    border-radius: 0;
}

/* Inputs follow the same radius as the surfaces around them */
:root:root .mx_Field,
:root:root .mx_Field input,
:root:root .mx_Field select,
:root:root .mx_Field textarea {
    border-radius: var(--ic-radius-md);
}

:root:root .mx_Dropdown_input {
    border-radius: var(--ic-radius-md);
}

/*
 * Dialogs: upstream sets them in a wide translucent frame. A hairline and one radius instead,
 * like every other surface that floats. (The lightbox, the spinner and the search have no frame:
 * upstream takes its box away.)
 */
:root:root .mx_Dialog_border {
    padding: 0;
    border: var(--ic-surface-border);
    border-radius: 16px;
    background: none;
    backdrop-filter: none;
    overflow: hidden;
}

:root:root .mx_Dialog_border > .mx_Dialog {
    border-radius: 0;
}
