// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`<LoginSplashView /> > Renders a spinner 1`] = `
<DocumentFragment>
  <div
    class="mx_MatrixChat_splash"
  >
    <div
      class="mx_Spinner mx_LatticeLoading"
    >
      <div
        aria-label="Loading…"
        class="mx_LatticeLoading_mark"
        data-testid="spinner"
        role="progressbar"
      >
        <svg
          aria-hidden="true"
          class="_mark mx_LatticeMark"
          data-testid="lattice-mark"
          data-variant="loading"
          height="72px"
          viewBox="0 0 512 512"
          width="72px"
        >
          <rect
            class="_tile"
            height="480"
            rx="112"
            width="480"
            x="16"
            y="16"
          />
          <circle
            class="_dot"
            cx="156"
            cy="132"
            r="22"
            style="animation-delay: 0.00s;"
          />
          <circle
            class="_dot"
            cx="256"
            cy="132"
            r="22"
            style="animation-delay: 0.12s;"
          />
          <circle
            class="_dot"
            cx="356"
            cy="132"
            r="22"
            style="animation-delay: 0.24s;"
          />
          <circle
            class="_dot"
            cx="356"
            cy="380"
            r="22"
            style="animation-delay: 0.36s;"
          />
          <circle
            class="_dot"
            cx="256"
            cy="380"
            r="22"
            style="animation-delay: 0.48s;"
          />
          <circle
            class="_dot"
            cx="156"
            cy="380"
            r="22"
            style="animation-delay: 0.60s;"
          />
          <rect
            class="_bar _accent"
            height="120"
            rx="22"
            width="44"
            x="134"
            y="196"
          />
          <rect
            class="_bar _light"
            height="160"
            rx="22"
            width="44"
            x="234"
            y="176"
          />
          <rect
            class="_bar _accent"
            height="140"
            rx="22"
            width="44"
            x="334"
            y="186"
          />
        </svg>
      </div>
    </div>
    <div
      class="mx_LoginSplashView_splashButtons"
    >
      <div
        class="mx_AccessibleButton mx_AccessibleButton_hasKind mx_AccessibleButton_kind_link_inline"
        role="button"
        tabindex="0"
      >
        Logout
      </div>
    </div>
  </div>
</DocumentFragment>
`;

